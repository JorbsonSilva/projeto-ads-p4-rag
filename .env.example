RAG_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API HTTP interna. Exporte estas variáveis no processo Uvicorn.
RAG_HTTP_MODE=simulated
RAG_INTERNAL_JWT_SECRET=
RAG_INTERNAL_JWT_ISSUER=orienta-spring
RAG_INTERNAL_JWT_AUDIENCE=orienta-rag
RAG_HTTP_IDLE_SECONDS=900
RAG_HTTP_MAX_SESSIONS=100
RAG_HTTP_MAX_TURNS=20
RAG_HTTP_MAX_MESSAGES=128
RAG_HTTP_MAX_CONCURRENT=4
